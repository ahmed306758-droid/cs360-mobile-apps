<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202225"
    android:fillViewport="true"
    android:contentDescription="@string/calendar_title"
    tools:context=".CalendarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calendar_title"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calendar_subtitle"
                    android:textColor="#B9BBBE"
                    android:textSize="15sp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <Button
                android:id="@+id/calendarSettingsButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:text="@string/icon_settings"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:backgroundTint="#4F545C"
                android:contentDescription="@string/settings_desc" />

        </LinearLayout>


        <!-- MONTH HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#303238"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/previousMonthButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/icon_prev"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#4F545C"
                android:contentDescription="@string/prev_month_desc" />

            <TextView
                android:id="@+id/monthYearText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/month_august_2026"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <Button
                android:id="@+id/nextMonthButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/icon_next"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#4F545C"
                android:contentDescription="@string/next_month_desc" />

        </LinearLayout>


        <!-- DAYS OF WEEK -->

