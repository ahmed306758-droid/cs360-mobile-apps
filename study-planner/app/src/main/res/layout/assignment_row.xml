<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assignmentRow"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#292B2F"
    android:paddingStart="10dp"
    android:paddingEnd="4dp"
    android:layout_marginTop="2dp">

    <TextView android:id="@+id/courseText" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.5" android:textColor="#FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/titleText" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:textColor="#FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/dueDateText" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.3" android:textColor="#FFFFFF" android:textSize="13sp" />
    <TextView android:id="@+id/priorityText" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.2" android:textSize="12sp" android:textStyle="bold" />
    <Button android:id="@+id/deleteButton" android:layout_width="48dp" android:layout_height="48dp"
        android:text="@string/delete_icon" android:textColor="#FFFFFF" android:textSize="12sp"
        android:backgroundTint="#4F545C" android:contentDescription="@string/delete_assignment_desc" />
</LinearLayout>
